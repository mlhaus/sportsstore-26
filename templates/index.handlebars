<div class="container-fluid">
    <div class="row">
        <div class="col-2">
            {{> category_controls }}
        </div>
        <div class="col">
            {{> search_controls }}
            {{> page_controls controlsId="top" }}
            <div class="d-flex justify-content-between flex-wrap flex-fill">
                {{#unless products}}<h4>No products</h4>{{/unless}}
                {{#each products }}
                    {{> product this }}
                {{/each}}
            </div>
            {{> page_controls controlsId="bottom" }}
        </div><!-- col -->
    </div><!-- row -->
</div><!-- container-fluid -->