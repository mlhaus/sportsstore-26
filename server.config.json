{
  "http": {
    "port": 3000,
    "content_security": {
      "contentSecurityPolicy": {
        "directives": {
          "upgradeInsecureRequests": null
        }
      }
    }
  },
  "templates": {
    "location": "templates",
    "config": {
      "layoutsDir": "templates",
      "defaultLayout": "main_layout.handlebars",
      "partialsDir": "templates"
    }
  },
  "errors": {
    "400": "not_found",
    "500": "error"
  },
  "catalog": {
    "orm_repo": {
      "settings": {
        "dialect": "postgres",
        "host": "localhost",
        "port": "5432",
        "username": "postgres",
        "password": "MySecret$"
      },
      "logging": true,
      "reset_db": false,
      "seed_file": "products.json"
    }
  },
  "sessions": {
    "maxAgeHrs": 2,
    "reset_db": false,
    "orm": {
      "settings": {
        "dialect": "postgres",
        "host": "localhost",
        "port": "5432",
        "username": "postgres",
        "password": "MySecret$"
      },
      "logging": true
    }
  },
  "auth": {
    "openauth": {
      "redirectionUrl": "http://localhost:3000/signin-google"
    }
  },
  "admin": {
    "openauth": {
      "redirectionUrl": "http://localhost:3000/auth-signin-google"
    },
    "users": ["alice@example.com", "marc.hauschildt@gmail.com"]
  }
}
